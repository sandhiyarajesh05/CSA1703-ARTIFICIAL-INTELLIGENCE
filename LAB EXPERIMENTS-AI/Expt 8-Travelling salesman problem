from itertools import permutations

# Distance matrix
graph = [
    [0, 10, 15, 20],
    [10, 0, 35, 25],
    [15, 35, 0, 30],
    [20, 25, 30, 0]
]

n = len(graph)
cities = list(range(n))

min_cost = float('inf')
best_path = []

# Starting city
start = 0

# Generate all possible paths
for path in permutations(cities[1:]):
    cost = 0
    current = start

    for city in path:
        cost += graph[current][city]
        current = city

    cost += graph[current][start]

    if cost < min_cost:
        min_cost = cost
        best_path = [start] + list(path) + [start]

print("Minimum Cost:", min_cost)
print("Optimal Path:", best_path)
