from queue import PriorityQueue

goal = [[1,2,3],
        [4,5,6],
        [7,8,0]]

def heuristic(state):
    count = 0
    for i in range(3):
        for j in range(3):
            if state[i][j] != goal[i][j] and state[i][j] != 0:
                count += 1
    return count

initial = [[1,2,3],
           [4,0,6],
           [7,5,8]]

print("Initial State:")
for row in initial:
    print(row)

print("\nHeuristic Value =", heuristic(initial))

if heuristic(initial)==0:
    print("Goal State Reached")
else:
    print("Puzzle is not solved.")
